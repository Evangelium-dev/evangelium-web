---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDonate } from '../../i18n/donate';

const t = getDonate('ca');
const locale = 'ca' as const;
const messages = {
	errorMin: t.errorMin,
	errorMax: t.errorMax,
	errorGeneric: t.errorGeneric,
	errorStart: t.errorStart,
	submitting: t.submitting,
	submit: t.submit,
};
---

<BaseLayout locale={locale} route="donate" title={t.title} description={t.description}>
	<main>
		<article class="donate">
			<h1>{t.heading}</h1>
			<p class="donate__lead">{t.lead}</p>
			<p>{t.p1}</p>
			<p>{t.p2}</p>
			<p>{t.p3}</p>

			<form
				id="donate-form"
				class="donate-form"
				novalidate
				data-locale={locale}
				data-messages={JSON.stringify(messages)}
			>
				<label class="donate-form__label" for="amount">{t.amountLabel}</label>
				<div class="donate-form__amount">
					<span class="donate-form__currency" aria-hidden="true">€</span>
					<input
						id="amount"
						name="amount"
						type="number"
						inputmode="decimal"
						min="0.50"
						max="10000"
						step="0.01"
						placeholder={t.placeholder}
						required
						autocomplete="off"
					/>
				</div>
				<p id="donate-error" class="donate-form__error" role="alert" hidden></p>
				<button type="submit" class="donate-form__submit" id="donate-submit">
					{t.submit}
				</button>
				<p class="donate-form__hint">{t.hint}</p>
			</form>
		</article>
	</main>
</BaseLayout>

<script>
	const form = document.getElementById('donate-form') as HTMLFormElement | null;
	const amountInput = document.getElementById('amount') as HTMLInputElement | null;
	const errorEl = document.getElementById('donate-error') as HTMLParagraphElement | null;
	const submitBtn = document.getElementById('donate-submit') as HTMLButtonElement | null;

	if (form && amountInput && errorEl && submitBtn) {
		const locale = form.dataset.locale || 'ca';
		const messages = JSON.parse(form.dataset.messages || '{}') as {
			errorMin: string;
			errorMax: string;
			errorGeneric: string;
			errorStart: string;
			submitting: string;
			submit: string;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			errorEl.hidden = true;
			errorEl.textContent = '';

			const amount = Number(amountInput.value.replace(',', '.'));
			if (!Number.isFinite(amount) || amount < 0.5) {
				errorEl.textContent = messages.errorMin;
				errorEl.hidden = false;
				amountInput.focus();
				return;
			}
			if (amount > 10000) {
				errorEl.textContent = messages.errorMax;
				errorEl.hidden = false;
				amountInput.focus();
				return;
			}

			const originalLabel = submitBtn.textContent;
			submitBtn.disabled = true;
			submitBtn.textContent = messages.submitting;

			try {
				const response = await fetch('/.netlify/functions/create-checkout', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ amount, locale }),
				});

				const data = (await response.json()) as { url?: string; error?: string };
				if (!response.ok || !data.url) {
					throw new Error(data.error || messages.errorStart);
				}

				window.location.href = data.url;
			} catch (error) {
				errorEl.textContent =
					error instanceof Error ? error.message : messages.errorGeneric;
				errorEl.hidden = false;
				submitBtn.disabled = false;
				submitBtn.textContent = originalLabel || messages.submit;
			}
		});
	}
</script>
