---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDonate } from '../../../i18n/donate';
import { localePath } from '../../../i18n/ui';

const t = getDonate('ca');
const backHref = localePath('ca', 'donate');
---

<BaseLayout
	locale="ca"
	route="donateThanks"
	title={t.thanksTitle}
	description={t.thanksDescription}
>
	<main>
		<article class="donate donate--thanks">
			<h1>{t.thanksHeading}</h1>
			<p class="donate__lead">{t.thanksLead}</p>
			<p>{t.thanksBody}</p>
			<p>
				<a class="donate-form__submit donate-form__submit--link" href={backHref}>
					{t.thanksBack}
				</a>
			</p>
		</article>
	</main>
</BaseLayout>
