---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Gracias por tu donación"
	description="Gracias por apoyar Evangelium y el desarrollo de Evangelio del día."
>
	<main>
		<article class="donate donate--thanks">
			<h1>Gracias</h1>

			<p class="donate__lead">
				Tu donación se ha recibido correctamente.
			</p>

			<p>
				Muchas gracias por tu generosidad. Tu ayuda se destinará exclusivamente al
				desarrollo, mantenimiento y mejora de Evangelium.
			</p>

			<p>
				<a class="donate-form__submit donate-form__submit--link" href="/donaciones/">
					Volver a donaciones
				</a>
			</p>
		</article>
	</main>
</BaseLayout>
